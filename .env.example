# ===== QRIS Dinamis server configuration =====

# HTTP port
PORT=8080

# ===== Storage =====
# STORAGE: sqlite (default, lokal) atau d1 (Cloudflare D1 via REST API)
STORAGE=sqlite

# --- SQLite lokal ---
# Kosong = data/qris.db
DATABASE_URL=
DATA_DIR=data
MIGRATIONS_DIR=migrations

# --- Cloudflare D1 (pakai STORAGE=d1) ---
D1_ACCOUNT_ID=
D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# ===== Frontend =====
WEB_DIR=web

# ===== Admin =====
# ADMIN_PASS minimal 8 karakter. Kosong = login admin disabled (HTTP 503).
ADMIN_USER=admin
ADMIN_PASS=
